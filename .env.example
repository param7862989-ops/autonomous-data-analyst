# Copy to .env (repository root) and fill in values. Never commit .env.
# The backend reads ../.env and backend/.env; Docker Compose reads this root .env.

# --- General ---------------------------------------------------------------
# One of: development, test, production
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# SQLAlchemy URL with the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://ada:change-me@localhost:5432/ada
# Server-side timeout for any single application query, in milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Auth ------------------------------------------------------------------
ALLOW_REGISTRATION=true
# Absolute session lifetime and inactivity timeout, in hours.
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=24
# Secure cookies are on automatically when ENVIRONMENT=production. Uncomment to force.
# COOKIE_SECURE=true
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=20
LOGIN_ATTEMPTS_PER_ACCOUNT_PER_15_MINUTES=10
REGISTRATIONS_PER_IP_PER_HOUR=10

# --- Storage ---------------------------------------------------------------
# Private directory for normalized dataset files (never served directly).
STORAGE_DIR=storage
