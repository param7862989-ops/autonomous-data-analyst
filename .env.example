# Copy to .env (repository root) and fill in values. Never commit .env.
# The backend reads ../.env and backend/.env; Docker Compose reads this root .env.

# --- General ---------------------------------------------------------------
# One of: development, test, production
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# --- Docker Compose ----------------------------------------------------------
# Used by docker-compose.yml (which builds DATABASE_URL for the backend itself).
POSTGRES_USER=ada
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ada
# Browser-facing origin of the app (also the allowed CORS/Origin value).
PUBLIC_ORIGIN=http://localhost:3000
# Production overlay only (deploy/docker-compose.prod.yml): the DNS name for TLS.
# DOMAIN=analyst.example.com

# --- Database (running the backend outside Docker) ---------------------------
# SQLAlchemy URL with the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://ada:change-me@localhost:5432/ada
# Server-side timeout for any single application query, in milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Auth ------------------------------------------------------------------
ALLOW_REGISTRATION=true
# Absolute session lifetime and inactivity timeout, in hours.
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=24
# Secure cookies are on automatically when ENVIRONMENT=production. Uncomment to force.
# COOKIE_SECURE=true
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=20
LOGIN_ATTEMPTS_PER_ACCOUNT_PER_15_MINUTES=10
REGISTRATIONS_PER_IP_PER_HOUR=10

# --- Storage ---------------------------------------------------------------
# Private directory for normalized dataset files (never served directly).
STORAGE_DIR=storage

# --- Language model -----------------------------------------------------------
# Without a key, upload and profiling work and analysis is disabled.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_REFUSAL_FALLBACK=true

# --- Agent bounds --------------------------------------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOOL_CALLS_PER_TURN=4
AGENT_DEADLINE_SECONDS=240
ANALYSIS_WORKERS=4
ANALYSES_PER_USER_PER_HOUR=30

# --- Analytical engine ---------------------------------------------------------
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
ANALYTICS_MEMORY_LIMIT=512MB
ANALYTICS_THREADS=2

# --- Uploads and limits ----------------------------------------------------
# If you raise MAX_UPLOAD_BYTES above 25 MB, also raise proxyClientMaxBodySize in
# frontend/next.config.ts and MAX_PROXIED_BODY_BYTES in frontend/src/proxy.ts.
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BODY_BYTES=1048576
MAX_DATASET_ROWS=500000
MAX_DATASET_COLUMNS=200
MAX_DATASET_CELLS=10000000
MAX_XLSX_UNCOMPRESSED_BYTES=262144000
MAX_DATASETS_PER_USER=100
UPLOADS_PER_USER_PER_HOUR=30
MAX_CONCURRENT_INGESTIONS=2
